+// Saturating doubling multiply long, with saturating accumulate (VQDMLAL) or
+// subtract (VQDMLSL): Qd = sat(Qd +/- sat(2 * Dn * Dm)).
+bool TranslatorVisitor::asimd_VQDMLAL(bool D, size_t sz, size_t Vn, size_t Vd, bool op, bool N, bool M, size_t Vm) {
+    if (sz == 0b11) {
+        return DecodeError();
+    }
+
+    if (sz == 0b00 || mcl::bit::get_bit<0>(Vd)) {
+        return UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(true, Vd, D);
+    const auto m = ToVector(false, Vm, M);
+    const auto n = ToVector(false, Vn, N);
+
+    const auto product = ir.VectorSignedSaturatedDoublingMultiplyLong(esize, ir.GetVector(n), ir.GetVector(m));
+    const auto reg_d = ir.GetVector(d);
+    const auto result = op ? ir.VectorSignedSaturatedSub(esize * 2, reg_d, product)
+                           : ir.VectorSignedSaturatedAdd(esize * 2, reg_d, product);
+
+    ir.SetVector(d, result);
+    return true;
+}
+
+bool TranslatorVisitor::asimd_VQDMULL(bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    if (sz == 0b11) {
+        return DecodeError();
+    }
+
+    if (sz == 0b00 || mcl::bit::get_bit<0>(Vd)) {
+        return UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(true, Vd, D);
+    const auto m = ToVector(false, Vm, M);
+    const auto n = ToVector(false, Vn, N);
+
+    ir.SetVector(d, ir.VectorSignedSaturatedDoublingMultiplyLong(esize, ir.GetVector(n), ir.GetVector(m)));
+    return true;
+}
+
+namespace {
+// Add or subtract quadwords, keep the high half of each element, narrow into a
+// doubleword (VADDHN/VSUBHN); U rounds first (VRADDHN/VRSUBHN).
+bool NarrowingHighHalf(TranslatorVisitor& v, bool round, bool subtract, bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    if (sz == 0b11) {
+        return v.DecodeError();
+    }
+
+    if (mcl::bit::get_bit<0>(Vn) || mcl::bit::get_bit<0>(Vm)) {
+        return v.UndefinedInstruction();
+    }
+
+    const size_t esize = 8U << sz;
+    const auto d = ToVector(false, Vd, D);
+    const auto n = ToVector(true, Vn, N);
+    const auto m = ToVector(true, Vm, M);
+
+    const auto reg_n = v.ir.GetVector(n);
+    const auto reg_m = v.ir.GetVector(m);
+    auto wide = subtract ? v.ir.VectorSub(esize * 2, reg_n, reg_m) : v.ir.VectorAdd(esize * 2, reg_n, reg_m);
+    if (round) {
+        const u64 half = u64(1) << (esize - 1);
+        const auto bias = esize == 8    ? v.ir.VectorBroadcast(16, v.ir.Imm16(static_cast<u16>(half)))
+                          : esize == 16 ? v.ir.VectorBroadcast(32, v.ir.Imm32(static_cast<u32>(half)))
+                                        : v.ir.VectorBroadcast(64, v.ir.Imm64(half));
+        wide = v.ir.VectorAdd(esize * 2, wide, bias);
+    }
+    const auto high = v.ir.VectorLogicalShiftRight(esize * 2, wide, static_cast<u8>(esize));
+    v.ir.SetVector(d, v.ir.VectorNarrow(esize * 2, high));
+    return true;
+}
+}  // Anonymous namespace
+
+bool TranslatorVisitor::asimd_VADDHN(bool U, bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    return NarrowingHighHalf(*this, U, false, D, sz, Vn, Vd, N, M, Vm);
+}
+
+bool TranslatorVisitor::asimd_VSUBHN(bool U, bool D, size_t sz, size_t Vn, size_t Vd, bool N, bool M, size_t Vm) {
+    return NarrowingHighHalf(*this, U, true, D, sz, Vn, Vd, N, M, Vm);
+}
+
 }  // namespace Dynarmic::A32
