+static void GravityGuyTracePc(A32JitState& context) {
+    static const bool enabled = std::getenv("VITA3K_GRAVITY_PC_TRACE") != nullptr;
+    static std::atomic<u32> active{};
+    static std::atomic<u32> dispatches{};
+    static std::atomic<u32> samples{};
+    if (!enabled) {
+        return;
+    }
+
+    const A32::LocationDescriptor location{context.GetLocationDescriptor()};
+    const u32 pc = location.PC();
+    u32 expected = 0;
+    if ((pc == 0x000a1fac || pc == 0x00053e48) &&
+        active.compare_exchange_strong(expected, 1, std::memory_order_relaxed)) {
+        dispatches.store(0, std::memory_order_relaxed);
+        samples.store(0, std::memory_order_relaxed);
+        std::fprintf(stderr,
+            "GRAVITY_PC_TRACE_BEGIN pc=0x%08x lr=0x%08x sp=0x%08x\n",
+            pc, context.regs[14], context.regs[13]);
+        std::fflush(stderr);
+    }
+    if (!active.load(std::memory_order_relaxed)) {
+        return;
+    }
+
+    const u32 dispatch = dispatches.fetch_add(1, std::memory_order_relaxed) + 1;
+    if ((dispatch & 63u) != 0) {
+        return;
+    }
+    const u32 sample = samples.fetch_add(1, std::memory_order_relaxed);
+    if (sample >= 128u) {
+        active.store(0, std::memory_order_relaxed);
+        return;
+    }
+    std::fprintf(stderr,
+        "GRAVITY_PC_TRACE sample=%u dispatch=%u pc=0x%08x thumb=%u "
+        "lr=0x%08x sp=0x%08x r0=0x%08x r1=0x%08x r2=0x%08x r3=0x%08x cpsr=0x%08x\n",
+        sample, dispatch, pc, location.TFlag() ? 1u : 0u,
+        context.regs[14], context.regs[13], context.regs[0], context.regs[1],
+        context.regs[2], context.regs[3], context.Cpsr());
+    std::fflush(stderr);
+    if (sample + 1u == 128u) {
+        active.store(0, std::memory_order_relaxed);
+        std::fprintf(stderr, "GRAVITY_PC_TRACE_END dispatch=%u\n", dispatch);
+        std::fflush(stderr);
+    }
+}
